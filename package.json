{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev:main": "vite build --watch --config shell/main/vite.config.ts",
    "dev:preload": "vite build --watch --config shell/preload/vite.config.ts",
    "dev:renderer": "vite dev --config shell/renderer/vite.config.ts",
    "dev:electron": "electron .",
    "build:plugins": "ts-node-esm --transpile-only scripts/build-plugins.mts",
    "dev": "ts-node-esm --transpile-only scripts/dev.mts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@module-federation/runtime": "^2.9.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@paymoapp/electron-shutdown-handler": "^1.2.0",
    "electron": "^45.0.0",
    "lokijs": "^1.5.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "rollup": "^4.65.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true,
    "@paymoapp/electron-shutdown-handler@1.2.0": true,
    "esbuild@0.28.2": true
  }
}
