{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@shell/*": ["shell/*"],
      "@plugins/*": ["plugins/*"],
      "@shared/*": ["shared/*"],
      "@extensions/*": ["extension-registry/*"],
      "@tessera/types": ["tessera-types/index.ts"],
      "@tessera/types/*": ["tessera-types/*"]
    }
  }
}
