{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@shell/*": ["shell/*"],
      "@plugins/*": ["plugins/*"],
      "@shared/*": ["shared/*"],
      "@extensions/*": ["extension-registry/*"],
      "@tessera/types": ["tessera-types/index.ts"],
      "@tessera/storage-kit": ["packages/storage-kit/index.ts"],
      "@tessera/book-api": ["packages/book-api/index.ts"],
      "@tessera/accounts-api": ["packages/accounts-api/index.ts"],
      "@tessera/recurring-api": ["packages/recurring-api/index.ts"],
      "@tessera/types/*": ["tessera-types/*"],
      "@tessera/ui": ["tessera-ui/index.ts"]
    }
  }
}
