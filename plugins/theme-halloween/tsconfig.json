{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tessera/types": ["../../tessera-types/index.ts"],
      "@tessera/types/*": ["../../tessera-types/*"]
    }
  },
  "include": ["src/**/*", "themes/*.json"]
}
