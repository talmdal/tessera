{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@core": ["core/*"],
      "@shell": ["shell/*"],
      "@tessera/types": ["../../tessera-types/index.ts"],
      "@tessera/types/*": [".../../tessera-types/*"]
    }
  },
  "include": ["src/**/*"]
}
