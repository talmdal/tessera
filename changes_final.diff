index 0000000..acf63ab
--- /dev/null
+++ b/core/storage/kit/DocumentStore.ts
@@ -0,0 +1,156 @@
+// core/storage/kit/DocumentStore.ts
+//
+// What KitCollection and KitDatabase need from a backend for one collection:
+// documents by id, the declared indexes, the unique-index maps, and a
+// version counter. MapStore is the in-memory implementation, used by the
+// memory engine and by every backend as the transaction overlay.
+import type { IndexSpec, Json, JsonObject } from '@tessera/types'
+import { StorageError } from '../errors'
+import { canonical, getPath } from '../json'
+
+export interface DocumentStore {
+  readonly size: number
+  get(id: string): JsonObject | undefined
+  /** Every document, in any order. Documents are treated as immutable: a write replaces, never edits. */
+  values(): Iterable<JsonObject>
+  /** Inserts or replaces. Index maintenance is the caller's job (see put/remove). */
+  set(id: string, doc: JsonObject): void
+  delete(id: string): void
+
+  indexes: IndexSpec[]
+  /** Unique index name → key → id. Documents missing any indexed field are left out (sparse). */
+  unique: Map<string, Map<string, string>>
+  /** Bumped by every committed write; transactions check it at commit. */
+  version: number
+
+  /** A copy for a transaction to work on. */
+  snapshot(): MapStore
+  /** Adopts the overlay's state for the documents a transaction wrote. */
+  apply(overlay: MapStore, touched: Set<string>): void
+}
+
+export class MapStore implements DocumentStore {
+  docs = new Map<string, JsonObject>()
+  indexes: IndexSpec[] = []
+  unique = new Map<string, Map<string, string>>()
+  version = 0
+
+  get size() {
+    return this.docs.size
+  }
+
+  get(id: string) {
+    return this.docs.get(id)
+  }
+
+  values() {
+    return this.docs.values()
+  }
+
+  set(id: string, doc: JsonObject) {
+    this.docs.set(id, doc)
+  }
+
+  delete(id: string) {
+    this.docs.delete(id)
+  }
+
+  snapshot(): MapStore {
+    const copy = new MapStore()
+    copy.docs = new Map(this.docs)
+    copy.indexes = [...this.indexes]
+    copy.unique = cloneUnique(this.unique)
+    copy.version = this.version
+    return copy
+  }
+
+  apply(overlay: MapStore) {
+    this.docs = overlay.docs
+    this.unique = overlay.unique
+  }
+}
+
+export const cloneUnique = (unique: Map<string, Map<string, string>>) =>
+  new Map([...unique].map(([name, keys]) => [name, new Map(keys)]))
+
+// ---------------------------------------------------------------------------
+// Index maintenance, shared by every backend.
+
+export function indexKey(doc: JsonObject, fields: string[]): string | undefined {
+  const values: Json[] = []
+  for (const field of fields) {
+    const value = getPath(doc, field)
+    if (value === undefined) return undefined
+    values.push(value)
+  }
+  return canonical(values)
+}
+
+/** Throws UNIQUE_VIOLATION if `doc` would duplicate another document's unique key. */
+export function checkUnique(store: DocumentStore, collection: string, doc: JsonObject, id: string): void {
+  for (const index of store.indexes) {
+    if (!index.unique) continue
+    const key = indexKey(doc, index.fields)
+    if (key === undefined) continue
+    const other = store.unique.get(index.name)?.get(key)
+    if (other !== undefined && other !== id) {
+      throw new StorageError('UNIQUE_VIOLATION', `Unique index "${index.name}" on ${collection} already has ${index.fields.join(', ')} = ${key}`,
+        { collection, index: index.name, id: other })
+    }
+  }
+}
+
+/** Builds a unique index over existing data, or throws UNIQUE_VIOLATION. */
+export function buildUnique(store: DocumentStore, collection: string, spec: IndexSpec): Map<string, string> {
+  const keys = new Map<string, string>()
+  for (const doc of store.values()) {
+    const id = doc.id as string
+    const key = indexKey(doc, spec.fields)
+    if (key === undefined) continue
+    const other = keys.get(key)
+    if (other !== undefined) {
+      throw new StorageError('UNIQUE_VIOLATION', `Cannot create unique index "${spec.name}" on ${collection}: ${other} and ${id} share ${key}`,
+        { collection, index: spec.name, id: other })
+    }
+    keys.set(key, id)
+  }
+  return keys
+}
+
+/** Rebuilds every unique map from the data, for a backend that has just loaded a collection. */
+export function rebuildUnique(store: DocumentStore, collection: string): void {
+  store.unique = new Map()
+  for (const spec of store.indexes) {
+    if (spec.unique) store.unique.set(spec.name, buildUnique(store, collection, spec))
+  }
+}
+
+function unindex(store: DocumentStore, doc: JsonObject | undefined): void {
+  if (!doc) return
+  for (const index of store.indexes) {
+    if (!index.unique) continue
+    const key = indexKey(doc, index.fields)
+    if (key !== undefined) store.unique.get(index.name)?.delete(key)
+  }
+}
+
+function index(store: DocumentStore, doc: JsonObject, id: string): void {
+  for (const spec of store.indexes) {
+    if (!spec.unique) continue
+    const key = indexKey(doc, spec.fields)
+    if (key !== undefined) store.unique.get(spec.name)!.set(key, id)
+  }
+}
+
+/** Inserts or replaces a document, keeping the unique maps right. Throws UNIQUE_VIOLATION first. */
+export function put(store: DocumentStore, collection: string, id: string, doc: JsonObject): void {
+  checkUnique(store, collection, doc, id)
+  unindex(store, store.get(id))
+  store.set(id, doc)
+  index(store, doc, id)
+}
+
+export function remove(store: DocumentStore, id: string): void {
+  unindex(store, store.get(id))
+  store.delete(id)
+}
diff --git a/core/storage/kit/KitCollection.ts b/core/storage/kit/KitCollection.ts
new file mode 100644
index 0000000..a10aad8
--- /dev/null
+++ b/core/storage/kit/KitCollection.ts
@@ -0,0 +1,296 @@
+// core/storage/kit/KitCollection.ts
+//
+// The Collection implementation every backend shares. All semantics live
+// here (validation, filters, updates, paging, aggregation, unique indexes);
+// a backend supplies DocumentStores through a Scope and persists them.
+import type {
+  Collection,
+  Document,
+  Filter,
+  FindOneOptions,
+  FindOptions,
+  IndexSpec,
+  Json,
+  JsonObject,
+  Page,
+  PageOptions,
+  ReplaceOptions,
+  Stage,
+  Stored,
+  Update,
+  UpdateResult
+} from '@tessera/types'
+import { runPipeline } from '../aggregate'
+import { compareToCursor, decodeCursor, encodeCursor } from '../cursor'
+import { normalizeDocument, sameIndex, validateCollectionName, validateIndexSpec } from '../documents'
+import { StorageError, invalidArgument, invalidDocument } from '../errors'
+import { compileFilter, filterEqualities, filterFields } from '../filter'
+import { cloneJson, setPath } from '../json'
+import { compileProjection } from '../projection'
+import { compileSort, sortFields } from '../sort'
+import { ulid } from '../ulid'
+import { applyUpdate } from '../update'
+import { type DocumentStore, buildUnique, put, remove } from './DocumentStore'
+
+export type ChangeKind = 'insert' | 'update' | 'delete'
+
+/** What a collection handle needs from its owner: a live database or a transaction. */
+export interface Scope {
+  readonly database: string
+  readonly engine: string
+  readonly inTransaction: boolean
+  /** The store to read, or undefined for a collection that doesn't exist yet. Throws NOT_OPEN / UNKNOWN_COLLECTION. */
+  read(name: string): DocumentStore | undefined
+  /** The store to write, created if allowed. Throws NOT_OPEN / READ_ONLY / UNKNOWN_COLLECTION. */
+  write(name: string): DocumentStore
+  /** Records a change to be announced after commit. */
+  changed(name: string, kind: ChangeKind, ids: string[]): void
+  /** Runs after a direct (non-transactional) write; a no-op inside a transaction. */
+  committed(name: string): void
+  /** The backend's answer to explain(); the kit adds what it knows. */
+  plan?(name: string, filter: Filter | undefined, options: FindOptions): JsonObject
+}
+
+export class KitCollection<T extends Document> implements Collection<T> {
+  constructor(readonly name: string, private readonly scope: Scope) {
+    validateCollectionName(name)
+  }
+
+  private docs(): JsonObject[] {
+    return [...(this.scope.read(this.name)?.values() ?? [])]
+  }
+
+  private out(doc: JsonObject): Stored<T> {
+    return cloneJson(doc) as unknown as Stored<T>
+  }
+
+  private present(doc: JsonObject, project: (doc: JsonObject) => JsonObject): Stored<T> {
+    return project(cloneJson(doc)) as unknown as Stored<T>
+  }
+
+  private matching(filter: Filter | undefined): JsonObject[] {
+    const predicate = compileFilter(filter)
+    return this.docs().filter(predicate)
+  }
+
+  private ordered(filter: Filter | undefined, options: FindOptions = {}): JsonObject[] {
+    const { sort, skip = 0, limit } = options
+    if (!Number.isInteger(skip) || skip < 0) throw invalidArgument('skip must be a non-negative integer')
+    if (limit !== undefined && (!Number.isInteger(limit) || limit < 0)) throw invalidArgument('limit must be a non-negative integer')
+    const docs = this.matching(filter).sort(compileSort(sort))
+    return docs.slice(skip, limit === undefined ? undefined : skip + limit)
+  }
+
+  // Reads
+
+  async get(id: string) {
+    const doc = this.scope.read(this.name)?.get(id)
+    return doc && this.out(doc)
+  }
+
+  async getMany(ids: string[]) {
+    const store = this.scope.read(this.name)
+    return ids.map(id => {
+      const doc = store?.get(id)
+      return doc && this.out(doc)
+    })
+  }
+
+  async findOne(filter?: Filter, options: FindOneOptions = {}) {
+    const [doc] = this.ordered(filter, { ...options, limit: 1 })
+    return doc && this.present(doc, compileProjection(options.projection))
+  }
+
+  async find(filter?: Filter, options: FindOptions = {}) {
+    const project = compileProjection(options.projection)
+    return this.ordered(filter, options).map(doc => this.present(doc, project))
+  }
+
+  async findPage(filter: Filter | undefined, options: PageOptions): Promise<Page<Stored<T>>> {
+    const { sort, limit, after } = options
+    if (!Number.isInteger(limit) || limit < 1) throw invalidArgument('findPage needs a positive limit')
+    let docs = this.matching(filter).sort(compileSort(sort))
+    if (after !== undefined) {
+      const keys = decodeCursor(after, sort)
+      docs = docs.filter(doc => compareToCursor(doc, keys, sort) > 0)
+    }
+    const page = docs.slice(0, limit)
+    const project = compileProjection(options.projection)
+    return {
+      items: page.map(doc => this.present(doc, project)),
+      ...(docs.length > limit ? { next: encodeCursor(page[page.length - 1], sort) } : {})
+    }
+  }
+
+  async count(filter?: Filter) {
+    return this.matching(filter).length
+  }
+
+  async *scan(options: { batchSize?: number } = {}): AsyncIterable<Stored<T>> {
+    const batchSize = options.batchSize ?? 500
+    const snapshot = this.docs().sort(compileSort(undefined))
+    for (let i = 0; i < snapshot.length; i += batchSize) {
+      for (const doc of snapshot.slice(i, i + batchSize)) yield this.out(doc)
+    }
+  }
+
+  // Writes
+
+  private insertInto(store: DocumentStore, doc: T): JsonObject {
+    const clean = normalizeDocument(doc)
+    const id = (clean.id as string | undefined) ?? ulid()
+    if (store.get(id)) throw new StorageError('DUPLICATE_ID', `${this.name} already has a document with id ${id}`, { collection: this.name, id })
+    const stored = { ...clean, id, rev: 1 }
+    put(store, this.name, id, stored)
+    return stored
+  }
+
+  async insert(doc: T) {
+    const store = this.scope.write(this.name)
+    const stored = this.insertInto(store, doc)
+    this.scope.changed(this.name, 'insert', [stored.id as string])
+    this.scope.committed(this.name)
+    return this.out(stored)
+  }
+
+  async insertMany(docs: T[]) {
+    if (!Array.isArray(docs)) throw invalidArgument('insertMany needs an array')
+    const store = this.scope.write(this.name)
+    // All or nothing: validate and apply against a scratch copy, then adopt it.
+    const scratch = store.snapshot()
+    const stored = docs.map(doc => this.insertInto(scratch, doc))
+    store.apply(scratch, new Set(stored.map(doc => doc.id as string)))
+    this.scope.changed(this.name, 'insert', stored.map(doc => doc.id as string))
+    this.scope.committed(this.name)
+    return stored.map(doc => this.out(doc))
+  }
+
+  async replace(doc: T & { id: string }, options: ReplaceOptions = {}) {
+    const clean = normalizeDocument(doc)
+    if (typeof clean.id !== 'string') throw invalidDocument('replace needs a document with an id')
+    const id = clean.id
+    const store = this.scope.write(this.name)
+    const existing = store.get(id)
+    if (options.expectedRev !== undefined && existing?.rev !== options.expectedRev) {
+      throw new StorageError('CONFLICT', `${this.name}/${id} is at rev ${existing?.rev ?? 'none'}, not ${options.expectedRev}`,
+        { collection: this.name, id, rev: (existing?.rev as number | undefined) ?? null })
+    }
+    if (!existing && !options.upsert) throw new StorageError('NOT_FOUND', `${this.name} has no document with id ${id}`, { collection: this.name, id })
+    const stored = { ...clean, id, rev: existing ? (existing.rev as number) + 1 : 1 }
+    put(store, this.name, id, stored)
+    this.scope.changed(this.name, existing ? 'update' : 'insert', [id])
+    this.scope.committed(this.name)
+    return this.out(stored)
+  }
+
+  private applyTo(store: DocumentStore, docs: JsonObject[], update: Update): UpdateResult {
+    let modified = 0
+    const ids: string[] = []
+    for (const doc of docs) {
+      const { doc: next, changed } = applyUpdate(doc, update)
+      if (!changed) continue
+      next.rev = (doc.rev as number) + 1
+      put(store, this.name, doc.id as string, next)
+      modified++
+      ids.push(doc.id as string)
+    }
+    if (ids.length) this.scope.changed(this.name, 'update', ids)
+    return { matched: docs.length, modified }
+  }
+
+  async updateOne(filter: Filter, update: Update, options: { upsert?: boolean } = {}) {
+    const store = this.scope.write(this.name)
+    const [doc] = this.matching(filter).sort(compileSort(undefined))
+    let result: UpdateResult
+    if (doc) {
+      result = this.applyTo(store, [doc], update)
+    } else if (options.upsert) {
+      const seed: JsonObject = {}
+      for (const [field, value] of Object.entries(filterEqualities(filter))) setPath(seed, field, value)
+      const { doc: built } = applyUpdate(seed, update)
+      const stored = this.insertInto(store, built as unknown as T)
+      this.scope.changed(this.name, 'insert', [stored.id as string])
+      result = { matched: 0, modified: 0, upsertedId: stored.id as string }
+    } else {
+      result = { matched: 0, modified: 0 }
+    }
+    this.scope.committed(this.name)
+    return result
+  }
+
+  async updateMany(filter: Filter, update: Update) {
+    const store = this.scope.write(this.name)
+    const result = this.applyTo(store, this.matching(filter), update)
+    this.scope.committed(this.name)
+    return result
+  }
+
+  private deleteDocs(store: DocumentStore, docs: JsonObject[]): number {
+    for (const doc of docs) remove(store, doc.id as string)
+    if (docs.length) this.scope.changed(this.name, 'delete', docs.map(doc => doc.id as string))
+    this.scope.committed(this.name)
+    return docs.length
+  }
+
+  async deleteOne(filter: Filter) {
+    const store = this.scope.write(this.name)
+    const [doc] = this.matching(filter).sort(compileSort(undefined))
+    return this.deleteDocs(store, doc ? [doc] : [])
+  }
+
+  async deleteMany(filter: Filter) {
+    const store = this.scope.write(this.name)
+    return this.deleteDocs(store, this.matching(filter))
+  }
+
+  // Reporting
+
+  async aggregate<R extends JsonObject = JsonObject>(pipeline: Stage[]) {
+    const docs = this.docs().sort(compileSort(undefined)).map(doc => cloneJson(doc))
+    const resolve = async (name: string) => [...(this.scope.read(name)?.values() ?? [])]
+    return (await runPipeline(docs, pipeline, resolve)) as R[]
+  }
+
+  // Schema
+
+  private schemaStore(): DocumentStore {
+    if (this.scope.inTransaction) throw invalidArgument('Index changes are not transactional; make them outside transaction()')
+    return this.scope.write(this.name)
+  }
+
+  async ensureIndex(spec: IndexSpec) {
+    validateIndexSpec(spec)
+    const store = this.schemaStore()
+    const existing = store.indexes.find(i => i.name === spec.name)
+    if (existing && sameIndex(existing, spec)) return
+    const clean: IndexSpec = { name: spec.name, fields: [...spec.fields], ...(spec.unique ? { unique: true } : {}) }
+    const keys = clean.unique ? buildUnique(store, this.name, clean) : undefined
+    store.indexes = [...store.indexes.filter(i => i.name !== spec.name), clean]
+    store.unique.delete(spec.name)
+    if (keys) store.unique.set(spec.name, keys)
+    this.scope.committed(this.name)
+  }
+
+  async dropIndex(name: string) {
+    const store = this.schemaStore()
+    store.indexes = store.indexes.filter(i => i.name !== name)
+    store.unique.delete(name)
+    this.scope.committed(this.name)
+  }
+
+  async indexes() {
+    return (this.scope.read(this.name)?.indexes ?? []).map(i => ({ ...i, fields: [...i.fields] }))
+  }
+
+  async explain(filter?: Filter, options: FindOptions = {}): Promise<Json> {
+    return {
+      engine: this.scope.engine,
+      collection: this.name,
+      scan: true,
+      index: null,
+      filterFields: filterFields(filter),
+      sortFields: sortFields(options.sort),
+      ...(this.scope.plan?.(this.name, filter, options) ?? {})
+    }
+  }
+}
diff --git a/core/storage/kit/KitDatabase.ts b/core/storage/kit/KitDatabase.ts
new file mode 100644
index 0000000..3c8c1c3
--- /dev/null
+++ b/core/storage/kit/KitDatabase.ts
@@ -0,0 +1,290 @@
+// core/storage/kit/KitDatabase.ts
+//
+// The Database implementation every backend shares: collection handles,
+// transactions (copy-on-write per collection, one at a time per database,
+// CONFLICT if a collection a transaction wrote was written outside it),
+// change events after commit, auto-create and read-only rules. A backend
+// implements DatabaseBackend: where stores and meta live and when to save.
+import type {
+  ChangeEvent,
+  Collection,
+  CollectionInfo,
+  CollectionSchema,
+  Database,
+  DatabaseMeta,
+  Disposable,
+  Document,
+  Filter,
+  FindOptions,
+  Json,
+  JsonObject,
+  OpenOptions,
+  Transaction
+} from '@tessera/types'
+import { validateCollectionName } from '../documents'
+import { StorageError, invalidArgument } from '../errors'
+import { cloneJson } from '../json'
+import { type DocumentStore, MapStore } from './DocumentStore'
+import { type ChangeKind, KitCollection, type Scope } from './KitCollection'
+
+export interface DatabaseBackend {
+  store(name: string): DocumentStore | undefined
+  createStore(name: string): DocumentStore
+  deleteStore(name: string): boolean
+  renameStore(from: string, to: string): void
+  storeNames(): string[]
+
+  metaGet(key: string): Json | undefined
+  metaSet(key: string, value: Json): void
+  metaDelete(key: string): void
+
+  /** After every committed write, schema change or meta change: a buffered backend schedules a save. */
+  touched(): void
+  /** What explain() reports beyond the kit's own fields. */
+  plan?(name: string, filter: Filter | undefined, options: FindOptions): JsonObject
+  flush(): Promise<void>
+  /** Final save and release. Called once. */
+  close(): Promise<void>
+}
+
+interface Changes {
+  insert: Set<string>
+  update: Set<string>
+  delete: Set<string>
+}
+
+export class KitDatabase implements Database {
+  private open = true
+  private listeners = new Set<(event: ChangeEvent) => void>()
+  private queue: Promise<void> = Promise.resolve()
+  private readonly autoCreate: boolean
+  readonly readOnly: boolean
+  readonly meta: DatabaseMeta
+
+  constructor(
+    readonly name: string,
+    readonly engine: string,
+    private readonly backend: DatabaseBackend,
+    options: OpenOptions,
+    private readonly onClose: () => void
+  ) {
+    this.readOnly = options.readOnly ?? false
+    this.autoCreate = options.autoCreate ?? options.schema === undefined
+    this.meta = {
+      get: async key => { this.assertOpen(); return cloneJson(backend.metaGet(key)) },
+      set: async (key, value) => { this.assertWritable(); backend.metaSet(key, cloneJson(value)); backend.touched() },
+      delete: async key => { this.assertWritable(); backend.metaDelete(key); backend.touched() }
+    }
+  }
+
+  get isOpen() {
+    return this.open
+  }
+
+  private assertOpen() {
+    if (!this.open) throw new StorageError('NOT_OPEN', `Database "${this.name}" is closed`, { database: this.name })
+  }
+
+  private assertWritable() {
+    this.assertOpen()
+    if (this.readOnly) throw new StorageError('READ_ONLY', `Database "${this.name}" was opened read-only`, { database: this.name })
+  }
+
+  private unknown(name: string) {
+    return new StorageError('UNKNOWN_COLLECTION', `Database "${this.name}" has no collection "${name}"`, { database: this.name, collection: name })
+  }
+
+  private emit(changes: Map<string, Changes>) {
+    for (const [collection, kinds] of changes) {
+      for (const kind of ['insert', 'update', 'delete'] as const) {
+        const ids = [...kinds[kind]]
+        if (!ids.length) continue
+        const event: ChangeEvent = { database: this.name, collection, kind, ids }
+        for (const listener of this.listeners) listener(event)
+      }
+    }
+  }
+
+  private record(changes: Map<string, Changes>, name: string, kind: ChangeKind, ids: string[]) {
+    let entry = changes.get(name)
+    if (!entry) changes.set(name, entry = { insert: new Set(), update: new Set(), delete: new Set() })
+    for (const id of ids) entry[kind].add(id)
+  }
+
+  /** The scope for direct use: reads and writes hit the live stores, each write is its own commit. */
+  private liveScope(): Scope {
+    const changes = new Map<string, Changes>()
+    return {
+      database: this.name,
+      engine: this.engine,
+      inTransaction: false,
+      read: name => {
+        this.assertOpen()
+        const store = this.backend.store(name)
+        if (!store && !this.autoCreate) throw this.unknown(name)
+        return store
+      },
+      write: name => {
+        this.assertWritable()
+        let store = this.backend.store(name)
+        if (!store) {
+          if (!this.autoCreate) throw this.unknown(name)
+          store = this.backend.createStore(name)
+        }
+        return store
+      },
+      changed: (name, kind, ids) => this.record(changes, name, kind, ids),
+      committed: name => {
+        const store = this.backend.store(name)
+        if (store) store.version++
+        this.backend.touched()
+        const pending = new Map(changes)
+        changes.clear()
+        this.emit(pending)
+      },
+      plan: this.backend.plan?.bind(this.backend)
+    }
+  }
+
+  collection<T extends Document = Document>(name: string): Collection<T> {
+    return new KitCollection<T>(name, this.liveScope())
+  }
+
+  async listCollections(): Promise<CollectionInfo[]> {
+    this.assertOpen()
+    return this.backend.storeNames()
+      .sort()
+      .map(name => {
+        const store = this.backend.store(name)!
+        return { name, indexes: store.indexes.map(i => ({ ...i, fields: [...i.fields] })), count: store.size }
+      })
+  }
+
+  async createCollection(schema: CollectionSchema) {
+    this.assertWritable()
+    validateCollectionName(schema.name)
+    if (!this.backend.store(schema.name)) {
+      this.backend.createStore(schema.name)
+      this.backend.touched()
+    }
+    const collection = new KitCollection(schema.name, { ...this.liveScope(), write: () => this.backend.store(schema.name)! })
+    for (const index of schema.indexes ?? []) await collection.ensureIndex(index)
+  }
+
+  async dropCollection(name: string) {
+    this.assertWritable()
+    const dropped = this.backend.deleteStore(name)
+    if (dropped) this.backend.touched()
+    return dropped
+  }
+
+  async renameCollection(from: string, to: string) {
+    this.assertWritable()
+    validateCollectionName(to)
+    if (!this.backend.store(from)) throw this.unknown(from)
+    if (this.backend.store(to)) throw invalidArgument(`Database "${this.name}" already has a collection "${to}"`)
+    this.backend.renameStore(from, to)
+    this.backend.touched()
+  }
+
+  async transaction<R>(work: (tx: Transaction) => Promise<R>): Promise<R> {
+    this.assertOpen()
+    let release!: () => void
+    const previous = this.queue
+    this.queue = new Promise<void>(resolve => { release = resolve })
+    await previous
+
+    try {
+      this.assertOpen()
+      const overlay = new Map<string, MapStore>()
+      const baseVersions = new Map<string, number>()
+      const created = new Set<string>()
+      const changes = new Map<string, Changes>()
+
+      const scope: Scope = {
+        database: this.name,
+        engine: this.engine,
+        inTransaction: true,
+        read: name => {
+          this.assertOpen()
+          const store = overlay.get(name) ?? this.backend.store(name)
+          if (!store && !this.autoCreate) throw this.unknown(name)
+          return store
+        },
+        write: name => {
+          this.assertWritable()
+          let store = overlay.get(name)
+          if (store) return store
+          const live = this.backend.store(name)
+          if (live) {
+            store = live.snapshot()
+            baseVersions.set(name, live.version)
+          } else {
+            if (!this.autoCreate) throw this.unknown(name)
+            store = new MapStore()
+            created.add(name)
+          }
+          overlay.set(name, store)
+          return store
+        },
+        changed: (name, kind, ids) => this.record(changes, name, kind, ids),
+        committed: () => {},
+        plan: this.backend.plan?.bind(this.backend)
+      }
+
+      const result = await work({ collection: <T extends Document = Document>(name: string) => new KitCollection<T>(name, scope) })
+
+      // Commit: nothing outside the transaction may have written the collections it touched.
+      if (overlay.size) this.assertWritable()
+      for (const [name, version] of baseVersions) {
+        if (this.backend.store(name)?.version !== version) {
+          throw new StorageError('CONFLICT', `Collection "${name}" was written outside the transaction`, { database: this.name, collection: name })
+        }
+      }
+      for (const name of created) {
+        if (this.backend.store(name)) {
+          throw new StorageError('CONFLICT', `Collection "${name}" was created outside the transaction`, { database: this.name, collection: name })
+        }
+      }
+      for (const [name, store] of overlay) {
+        const live = this.backend.store(name) ?? this.backend.createStore(name)
+        live.apply(store, touchedIds(changes.get(name)))
+        live.version++
+      }
+      if (overlay.size) this.backend.touched()
+      this.emit(changes)
+      return result
+    } finally {
+      release()
+    }
+  }
+
+  onDidChange(listener: (event: ChangeEvent) => void): Disposable {
+    this.listeners.add(listener)
+    return { dispose: () => { this.listeners.delete(listener) } }
+  }
+
+  async flush() {
+    this.assertOpen()
+    await this.backend.flush()
+  }
+
+  async close() {
+    if (!this.open) return
+    await this.queue
+    this.open = false
+    this.listeners.clear()
+    try {
+      await this.backend.close()
+    } finally {
+      this.onClose()
+    }
+  }
+}
+
+function touchedIds(changes: Changes | undefined): Set<string> {
+  const ids = new Set<string>()
+  if (!changes) return ids
+  for (const kind of ['insert', 'update', 'delete'] as const) for (const id of changes[kind]) ids.add(id)
+  return ids
+}
diff --git a/core/storage/memory/MemoryStorageEngine.ts b/core/storage/memory/MemoryStorageEngine.ts
new file mode 100644
index 0000000..f20a9e6
--- /dev/null
+++ b/core/storage/memory/MemoryStorageEngine.ts
@@ -0,0 +1,106 @@
+// core/storage/memory/MemoryStorageEngine.ts
+//
+// The in-memory storage engine: the reference implementation of the contract
+// in tessera-types/storage.ts, and the backend domain-plugin tests run
+// against. Everything is the shared kit (KitDatabase over MapStores); this
+// file only keeps the stores. Nothing is persisted beyond the engine
+// instance, but a database survives close() and open() on the same engine,
+// so the conformance suite's persistence tests hold for it too.
+import type { Database, DatabaseTarget, Json, OpenOptions, StorageCapabilities, StorageEngine } from '@tessera/types'
+import { invalidArgument } from '../errors'
+import { type DatabaseBackend, KitDatabase } from '../kit/KitDatabase'
+import { type DocumentStore, MapStore } from '../kit/DocumentStore'
+import { ulid } from '../ulid'
+
+class MapBackend implements DatabaseBackend {
+  readonly stores = new Map<string, MapStore>()
+  readonly meta = new Map<string, Json>()
+
+  store(name: string): DocumentStore | undefined {
+    return this.stores.get(name)
+  }
+
+  createStore(name: string) {
+    const store = new MapStore()
+    this.stores.set(name, store)
+    return store
+  }
+
+  deleteStore(name: string) {
+    return this.stores.delete(name)
+  }
+
+  renameStore(from: string, to: string) {
+    const store = this.stores.get(from)!
+    this.stores.delete(from)
+    this.stores.set(to, store)
+  }
+
+  storeNames() {
+    return [...this.stores.keys()]
+  }
+
+  metaGet(key: string) {
+    return this.meta.get(key)
+  }
+
+  metaSet(key: string, value: Json) {
+    this.meta.set(key, value)
+  }
+
+  metaDelete(key: string) {
+    this.meta.delete(key)
+  }
+
+  touched() {}
+
+  async flush() {}
+
+  async close() {}
+}
+
+const targetKey = (target: DatabaseTarget) => ('path' in target ? `path:${target.path}` : `name:${target.name}`)
+
+export class MemoryStorageEngine implements StorageEngine {
+  readonly id: string = 'memory'
+  private readonly backends = new Map<string, MapBackend>()
+  private readonly handles = new Map<string, KitDatabase>()
+
+  capabilities(): StorageCapabilities {
+    return { aggregate: 'emulated', regex: 'emulated', textSearch: 'emulated', writeThrough: true }
+  }
+
+  async open(target: DatabaseTarget, options: OpenOptions = {}): Promise<Database> {
+    const key = targetKey(target)
+    const name = 'path' in target ? target.path : target.name
+    if (typeof name !== 'string' || name === '') throw invalidArgument('A database needs a name or path')
+
+    let handle = this.handles.get(key)
+    if (!handle) {
+      let backend = this.backends.get(key)
+      if (!backend) this.backends.set(key, backend = new MapBackend())
+      handle = new KitDatabase(name, this.id, backend, options, () => { this.handles.delete(key) })
+      this.handles.set(key, handle)
+    }
+    for (const schema of options.schema ?? []) await handle.createCollection(schema)
+    return handle
+  }
+
+  async list() {
+    return [...this.backends.keys()].filter(key => key.startsWith('name:')).map(key => key.slice(5)).sort()
+  }
+
+  async drop(target: DatabaseTarget) {
+    const key = targetKey(target)
+    await this.handles.get(key)?.close()
+    this.backends.delete(key)
+  }
+
+  newId() {
+    return ulid()
+  }
+
+  async closeAll() {
+    for (const handle of [...this.handles.values()]) await handle.close()
+  }
+}
