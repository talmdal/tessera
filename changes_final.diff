@@ -0,0 +1,65 @@
+// Bringing each `ledger.schema` contributor's data up to its plugin's version.
+import type { Database } from '@tessera/types'
+import { LEDGER_META, LedgerError, type SchemaContribution } from '@tessera/ledger-api'
+import type { SchemaRegistry } from './SchemaRegistry'
+import { scopedDatabase } from './scopedDatabase'
+
+export interface MigrationStep {
+  contribution: SchemaContribution
+  /** The version in the file (0: none of this contributor's data yet). */
+  from: number
+}
+
+export interface MigrationPlan {
+  steps: MigrationStep[]
+  /** True when existing data will change (a step from version 1 or later), so the file must be backed up first. */
+  needsBackup: boolean
+}
+
+/** Reads the contributors' versions from a ledger's meta. */
+export async function schemaVersions(db: Database, contributions: readonly SchemaContribution[]): Promise<Record<string, number>> {
+  const versions: Record<string, number> = {}
+  for (const { id } of contributions) {
+    const version = await db.meta.get(LEDGER_META.schemaVersion(id))
+    versions[id] = typeof version === 'number' && Number.isInteger(version) && version > 0 ? version : 0
+  }
+  return versions
+}
+
+/**
+ * What opening a ledger with these versions needs. A file newer than a plugin is refused: the plugin can't know
+ * what the newer data means, and writing to it could damage it. A contributor whose plugin isn't installed isn't
+ * in `contributions`, so its data is left as it is.
+ */
+export function planMigrations(contributions: readonly SchemaContribution[], versions: Record<string, number>, fileName: string): MigrationPlan {
+  const steps: MigrationStep[] = []
+  for (const contribution of contributions) {
+    const from = versions[contribution.id] ?? 0
+    if (from > contribution.version) {
+      throw new LedgerError('UNSUPPORTED_FILE',
+        `“${fileName}” was saved by a newer version of the “${contribution.id}” plugin (data version ${from}; this one understands ${contribution.version}). Update Tessera to open it.`)
+    }
+    if (from < contribution.version) steps.push({ contribution, from })
+  }
+  return { steps, needsBackup: steps.some(step => step.from > 0) }
+}
+
+/**
+ * Runs each step, one version at a time, recording each version as soon as it is reached, so a crash part way
+ * resumes from the last finished version. A migrator that throws stops everything.
+ */
+export async function runMigrations(db: Database, plan: MigrationPlan, registry: SchemaRegistry): Promise<void> {
+  for (const { contribution, from } of plan.steps) {
+    const migrator = registry.migrator(contribution)
+    const scoped = scopedDatabase(db, contribution.id)
+    for (let version = from; version < contribution.version; version++) {
+      try {
+        await migrator.migrate(scoped, version)
+      } catch (err) {
+        throw new LedgerError('MIGRATION_FAILED',
+          `The data of “${contribution.id}” could not be brought from version ${version} to ${version + 1}: ${err instanceof Error ? err.message : String(err)}`)
+      }
+      await db.meta.set(LEDGER_META.schemaVersion(contribution.id), version + 1)
+    }
+  }
+}
diff --git a/plugins/ledger/src/privileged/scopedDatabase.ts b/plugins/ledger/src/privileged/scopedDatabase.ts
new file mode 100644
index 0000000..396f5a6
--- /dev/null
+++ b/plugins/ledger/src/privileged/scopedDatabase.ts
@@ -0,0 +1,56 @@
+// What a contributor sees of the open ledger: its own collections and meta keys (`<contributor>.…`), nothing else.
+import type { ChangeEvent, CollectionSchema, Database, DatabaseMeta, Transaction } from '@tessera/types'
+import { LedgerError } from '@tessera/ledger-api'
+
+function guard(contributor: string) {
+  const prefix = `${contributor}.`
+  return (name: string) => {
+    if (typeof name !== 'string' || !name.startsWith(prefix)) {
+      throw new LedgerError('INVALID', `"${contributor}" may only use names starting with "${prefix}", not "${String(name)}"`)
+    }
+    return name
+  }
+}
+
+/** A transaction limited to the contributor's collections. */
+export function scopedTransaction(tx: Transaction, contributor: string): Transaction {
+  const check = guard(contributor)
+  return { collection: name => tx.collection(check(name)) }
+}
+
+/**
+ * The open ledger's database as one contributor may use it. Collections and meta keys outside `<contributor>.` are
+ * rejected, change events are filtered to its own collections, and closing is the ledger's job, not a contributor's.
+ */
+export function scopedDatabase(db: Database, contributor: string): Database {
+  const check = guard(contributor)
+  const mine = (name: string) => name.startsWith(`${contributor}.`)
+
+  // async, so a refused key rejects like any other failure rather than throwing before a promise exists
+  const meta: DatabaseMeta = {
+    get: async key => db.meta.get(check(key)),
+    set: async (key, value) => db.meta.set(check(key), value),
+    delete: async key => db.meta.delete(check(key))
+  }
+
+  return {
+    get name() { return db.name },
+    get readOnly() { return db.readOnly },
+    collection: name => db.collection(check(name)),
+    listCollections: async () => (await db.listCollections()).filter(mine),
+    createCollection: (schema: CollectionSchema) => db.createCollection({ ...schema, name: check(schema.name) }),
+    dropCollection: name => db.dropCollection(check(name)),
+    renameCollection: (from, to) => db.renameCollection(check(from), check(to)),
+    transaction: work => db.transaction(tx => work(scopedTransaction(tx, contributor))),
+    onDidChange: listener => db.onDidChange(event => {
+      const own: ChangeEvent = {
+        changes: event.changes.filter(change => mine(change.collection)),
+        structure: event.structure.filter(change => mine(change.collection))
+      }
+      if (own.changes.length + own.structure.length > 0) listener(own)
+    }),
+    meta,
+    flush: () => db.flush(),
+    close: () => Promise.reject(new LedgerError('INVALID', 'The ledger closes its database; use ledger.session.close()'))
+  }
+}
diff --git a/plugins/ledger/src/renderer/LedgerTree.tsx b/plugins/ledger/src/renderer/LedgerTree.tsx
