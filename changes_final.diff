@@ -0,0 +1,31 @@
+// core/storage/sort.ts
+import type { Json, Sort } from '@tessera/types'
+import { invalidArgument } from './errors'
+import { compareJson, getPath } from './json'
+
+export type Comparator = (a: Json, b: Json) => number
+
+/**
+ * A comparator for a Sort spec, ending with `id` ascending unless the spec
+ * names it, so the order is total and pagination cursors are unambiguous.
+ */
+export function compileSort(sort: Sort | undefined, tieBreak = 'id'): Comparator {
+  const entries = Object.entries(sort ?? {})
+  for (const [field, direction] of entries) {
+    if (direction !== 1 && direction !== -1) throw invalidArgument(`Sort direction for ${field} must be 1 or -1`)
+  }
+  if (tieBreak && !entries.some(([field]) => field === tieBreak)) entries.push([tieBreak, 1])
+  return (a, b) => {
+    for (const [field, direction] of entries) {
+      const result = compareJson(getPath(a, field), getPath(b, field))
+      if (result !== 0) return result * direction
+    }
+    return 0
+  }
+}
+
+export function sortFields(sort: Sort | undefined, tieBreak = 'id'): string[] {
+  const fields = Object.keys(sort ?? {})
+  if (tieBreak && !fields.includes(tieBreak)) fields.push(tieBreak)
+  return fields
+}
diff --git a/core/storage/ulid.ts b/core/storage/ulid.ts
new file mode 100644
index 0000000..54b788c
--- /dev/null
+++ b/core/storage/ulid.ts
@@ -0,0 +1,43 @@
+// core/storage/ulid.ts
+//
+// ULIDs: 26 characters of Crockford base32, the first 10 the millisecond
+// timestamp, the last 16 random. Lexical order is creation order, which is
+// what makes them good document ids. Ids made in the same millisecond are
+// made increasing by incrementing the random part, as the spec suggests.
+const ALPHABET = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
+
+let lastTime = 0
+let lastRandom: number[] = []
+
+function randomBytes(count: number): number[] {
+  const bytes = new Uint8Array(count)
+  const crypto = (globalThis as { crypto?: { getRandomValues?: (array: Uint8Array) => Uint8Array } }).crypto
+  if (crypto?.getRandomValues) {
+    crypto.getRandomValues(bytes)
+  } else {
+    for (let i = 0; i < count; i++) bytes[i] = Math.floor(Math.random() * 256)
+  }
+  return [...bytes]
+}
+
+export function ulid(now: number = Date.now()): string {
+  let time = ''
+  let remaining = now
+  for (let i = 0; i < 10; i++) {
+    time = ALPHABET[remaining % 32] + time
+    remaining = Math.floor(remaining / 32)
+  }
+
+  if (now === lastTime) {
+    // Increment the 80-bit random part, carrying from the low end.
+    for (let i = lastRandom.length - 1; i >= 0; i--) {
+      if (lastRandom[i] < 31) { lastRandom[i]++; break }
+      lastRandom[i] = 0
+    }
+  } else {
+    lastTime = now
+    lastRandom = randomBytes(16).map(byte => byte % 32)
+  }
+
+  return time + lastRandom.map(digit => ALPHABET[digit]).join('')
+}
