@@ -0,0 +1,75 @@
+// What the accounts plugin adds to the shell, as plain data: the Accounts menu, the navigator and the dialogs.
+import { DIALOGS_EXTENSION_POINT, type DialogContribution } from '@tessera/types'
+import { LEDGER_CONTEXT_KEYS } from '@tessera/ledger-api'
+import {
+  ACCOUNTS_COMMANDS as C, ACCOUNTS_CONTEXT_KEYS, ACCOUNTS_DIALOGS, ACCOUNTS_VIEWS, RECONCILE_ACTIONS_POINT, STATEMENT_RECONCILER,
+  type ReconcileActionContribution
+} from '@tessera/accounts-api'
+
+const MENU = 'accounts.menu'
+const VIEW_MENU = 'shell.view'
+
+const item = (id: string, label: string, command: string, group: string, extra: object = {}) =>
+  ({ kind: 'item', id, label, parent: MENU, group, command, ...extra })
+
+export const MENUS = [
+  { kind: 'menu', id: MENU, label: '&Accounts' },
+  { kind: 'group', id: 'accounts.menu.account', parent: MENU, order: 0 },
+  { kind: 'group', id: 'accounts.menu.subLedger', parent: MENU, order: 10 },
+  { kind: 'group', id: 'accounts.menu.move', parent: MENU, order: 20 },
+  { kind: 'group', id: 'accounts.menu.register', parent: MENU, order: 30 },
+  item('accounts.menu.new', '&New Account…', C.newAccount, 'accounts.menu.account'),
+  item('accounts.menu.edit', '&Edit Account…', C.editAccount, 'accounts.menu.account'),
+  item('accounts.menu.close', '&Close Account…', C.closeAccount, 'accounts.menu.account'),
+  item('accounts.menu.reopen', '&Reopen Account', C.reopenAccount, 'accounts.menu.account'),
+  item('accounts.menu.delete', '&Delete Account…', C.deleteAccount, 'accounts.menu.account'),
+  item('accounts.menu.newSubLedger', 'New &Sub-Ledger…', C.newSubLedger, 'accounts.menu.subLedger'),
+  item('accounts.menu.renameSubLedger', 'Re&name Sub-Ledger…', C.renameSubLedger, 'accounts.menu.subLedger'),
+  item('accounts.menu.deleteSubLedger', 'Delete Su&b-Ledger…', C.deleteSubLedger, 'accounts.menu.subLedger'),
+  item('accounts.menu.move', '&Move To…', C.move, 'accounts.menu.move'),
+  item('accounts.menu.register', '&Open Register', C.showRegister, 'accounts.menu.register'),
+  // Ctrl+N is not a key text fields use, so it is safe as a menu accelerator while the user types in the register
+  item('accounts.menu.newTransaction', 'New &Transaction', C.newTransaction, 'accounts.menu.register', { accelerator: 'CmdOrCtrl+N' }),
+  item('accounts.menu.reconcile', 'Reconcile with &Statement…', C.reconcileStatement, 'accounts.menu.register'),
+  { kind: 'item', id: 'accounts.view.accounts', label: '&Accounts', parent: VIEW_MENU, command: C.open }
+] as const
+
+export const VIEWS = [
+  {
+    id: ACCOUNTS_VIEWS.navigator, title: 'Accounts', slot: 'shell.left', module: './Navigator', icon: 'AccountBalance',
+    order: -100, when: LEDGER_CONTEXT_KEYS.isOpen
+  },
+  {
+    id: ACCOUNTS_VIEWS.register, title: 'Register', slot: 'shell.main', module: './Register', icon: 'List',
+    order: -50, when: LEDGER_CONTEXT_KEYS.isOpen
+  },
+  // Beside the navigator while the register's account is being reconciled
+  {
+    id: ACCOUNTS_VIEWS.reconcile, title: 'Reconcile', slot: 'shell.left', module: './ReconcilePanel', icon: 'Check',
+    order: -90, when: ACCOUNTS_CONTEXT_KEYS.reconciling
+  }
+] as const
+
+export const DIALOGS: DialogContribution[] = [
+  { id: ACCOUNTS_DIALOGS.account, title: 'New Account', module: './AccountDialog', size: 'sm' },
+  { id: ACCOUNTS_DIALOGS.move, title: 'Move To', module: './MoveDialog', size: 'xs' },
+  { id: ACCOUNTS_DIALOGS.reconcile, title: 'Reconcile with Statement', module: './ReconcileDialog', size: 'sm' }
+]
+
+/** The built-in reconciler, offered through the same extension point as any plugin's. */
+export const RECONCILE_ACTIONS: ReconcileActionContribution[] = [
+  {
+    id: STATEMENT_RECONCILER, label: 'Reconcile with Statement…', scope: 'account', command: C.reconcileStatement,
+    icon: 'Check', description: 'Mark the transactions on a bank statement, and balance the account with it'
+  }
+]
+
+/** Every contribution, as `[point, id, impl]`. */
+export function contributions(): [string, string, unknown][] {
+  return [
+    ...MENUS.map(m => ['shell.menus', m.id, m] as [string, string, unknown]),
+    ...VIEWS.map(v => ['shell.views', v.id, v] as [string, string, unknown]),
+    ...DIALOGS.map(d => [DIALOGS_EXTENSION_POINT, d.id, d] as [string, string, unknown]),
+    ...RECONCILE_ACTIONS.map(a => [RECONCILE_ACTIONS_POINT, a.id, a] as [string, string, unknown])
+  ]
+}
diff --git a/plugins/accounts/src/privileged/index.ts b/plugins/accounts/src/privileged/index.ts
new file mode 100644
index 0000000..8a7bb11
--- /dev/null
+++ b/plugins/accounts/src/privileged/index.ts
@@ -0,0 +1,76 @@
+// The accounts plugin: the accounts of the open ledger. It stores them through `ledger.schema`, offers them to other
+// plugins as `accounts.service`, and shows them in the Accounts navigator, which replaces the ledger's own panel.
+// See docs/account-manager-design.md, "The chart of accounts".
+import type { PluginContext, ShellPrompts } from '@tessera/types'
+import { SHELL_PROMPTS_SERVICE } from '@tessera/types'
+import { LEDGER_SCHEMA_POINT, LEDGER_SESSION_SERVICE, type LedgerSession } from '@tessera/ledger-api'
+import {
+  ACCOUNTS_MIGRATOR_SERVICE, ACCOUNTS_PLUGIN_ID, ACCOUNTS_SERVICE, ACCOUNTS_VIEWS, type AccountsService
+} from '@tessera/accounts-api'
+import { AccountsServiceImpl } from './AccountsServiceImpl'
+import { registerCommands } from './commands'
+import { contributions } from './contributions'
+import { publishChange, registerIpc } from './ipc'
+import { ReconcileActions } from './reconcileActions'
+import { RegisterState } from './register'
+import { ACCOUNTS_SCHEMA, accountsMigrator } from './schema'
+import { SelectionState } from './selection'
+
+/** Exactly the `AccountsService` contract, so other plugins can't reach the implementation's internals. */
+export function publicService(service: AccountsServiceImpl): AccountsService {
+  return {
+    get: id => service.get(id),
+    list: filter => service.list(filter),
+    chart: options => service.chart(options),
+    balances: id => service.balances(id),
+    createAccount: input => service.createAccount(input),
+    updateAccount: (id, patch, options) => service.updateAccount(id, patch, options),
+    closeAccount: (id, options) => service.closeAccount(id, options),
+    reopenAccount: (id, options) => service.reopenAccount(id, options),
+    deleteAccount: (id, options) => service.deleteAccount(id, options),
+    moveAccount: (id, to, index) => service.moveAccount(id, to, index),
+    transactions: accountId => service.transactions(accountId),
+    payees: service.payees,
+    categories: service.categories,
+    reconciliation: service.reconciliation,
+    onDidChange: service.onDidChange
+  }
+}
+
+export async function activate(context: PluginContext) {
+  const session = context.services.get<LedgerSession>(LEDGER_SESSION_SERVICE)
+  const prompts = context.services.get<ShellPrompts>(SHELL_PROMPTS_SERVICE)
+  const service = new AccountsServiceImpl({ session, log: context.logger })
+  const selection = new SelectionState(context, service, session)
+  const register = new RegisterState(context, service, session)
+  const actions = new ReconcileActions(context.extensions, context.commands, context.logger)
+
+  const reveal = async (viewId: string) => {
+    if (context.commands.has('shell.layout.reveal')) await context.commands.execute('shell.layout.reveal', viewId).catch(() => undefined)
+  }
+
+  context.subscriptions.push(
+    { dispose: () => service.dispose() },
+    // Declared before any ledger opens (the ledger reopens the last one once every plugin has activated)
+    context.extensions.contribute(ACCOUNTS_PLUGIN_ID, LEDGER_SCHEMA_POINT, ACCOUNTS_PLUGIN_ID, ACCOUNTS_SCHEMA),
+    context.services.provide(ACCOUNTS_PLUGIN_ID, ACCOUNTS_MIGRATOR_SERVICE, accountsMigrator),
+    context.services.provide(ACCOUNTS_PLUGIN_ID, ACCOUNTS_SERVICE, publicService(service)),
+    session.participate(ACCOUNTS_PLUGIN_ID, service.participant),
+    // The navigator shows the ledger tree with accounts in it, so the ledger's own panel steps aside
+    session.registerNavigator(ACCOUNTS_PLUGIN_ID),
+    service.onDidChange(async change => {
+      await selection.refresh()
+      await register.refresh()
+      await publishChange(context, service, session, change)
+    }),
+    session.onDidChange(change => {
+      if (change.type === 'opened' && change.created) void reveal(ACCOUNTS_VIEWS.navigator)
+    }),
+    ...contributions().map(([point, id, impl]) => context.extensions.contribute(ACCOUNTS_PLUGIN_ID, point, id, impl)),
+    ...registerCommands(context, service, selection, register, prompts),
+    ...registerIpc(context, service, session, selection, register, actions)
+  )
+
+  await selection.refresh()
+  await register.refresh()
+}
diff --git a/plugins/accounts/src/privileged/ipc.ts b/plugins/accounts/src/privileged/ipc.ts
new file mode 100644
index 0000000..4a1c0b5
--- /dev/null
+++ b/plugins/accounts/src/privileged/ipc.ts
@@ -0,0 +1,210 @@
+// The accounts views talk to the plugin here.
+import type { Disposable, IpcMessage, PluginContext } from '@tessera/types'
+import type { LedgerSession } from '@tessera/ledger-api'
+import { isLedgerError } from '@tessera/ledger-api'
+import {
+  ACCOUNTS_CHANNELS, ACCOUNTS_EVENTS, AccountsError, CLEARING_STATUSES, isAccountsError, toAccountsResult,
+  type AccountPatch, type Category, type Chart, type ClearingStatus, type MoveRequest, type RegisterSnapshot,
+  type AccountsChange, type PatchTransactionRequest, type ReconcileRequest, type ReconcileState, type ResolvedReconcileAction,
+  type SaveAccountRequest, type SaveTransactionRequest, type Selection, type TransactionPatch, type TransactionsRequest
+} from '@tessera/accounts-api'
+import type { ReconcileActions } from './reconcileActions'
+import type { AccountsServiceImpl } from './AccountsServiceImpl'
+import type { RegisterState } from './register'
+import { isSelection, local, type SelectionState } from './selection'
+
+/** What `work` reads, or `none` when no ledger is open, including one that closed while it was reading. */
+async function unlessClosed<T, N>(session: LedgerSession, work: () => Promise<T>, none: N): Promise<T | N> {
+  if (!session.current) return none
+  try {
+    return await work()
+  } catch (err) {
+    if (isAccountsError(err) && err.code === 'NO_LEDGER') return none
+    throw err
+  }
+}
+
+/** The chart, or null when no ledger is open. */
+export function chartOrNull(service: AccountsServiceImpl, session: LedgerSession): Promise<Chart | null> {
+  return unlessClosed(session, () => service.chart(), null)
+}
+
+/** An account's reconciliation in progress, or null when it has none (or the ledger closed). */
+export function reconcileStateOrNull(service: AccountsServiceImpl, session: LedgerSession, accountId: string): Promise<ReconcileState | null> {
+  return unlessClosed(session, async () => (await service.reconciliation.get(accountId).catch(err => {
+    if (isAccountsError(err) && err.code === 'NOT_FOUND') return undefined
+    throw err
+  })) ?? null, null)
+}
+
+/**
+ * Pushes what a change touched to the views: the chart (whole), the accounts whose transactions changed, categories,
+ * and the reconciliation of every account whose reconciliation or transactions changed (an edited amount changes it).
+ */
+export async function publishChange(
+  context: Pick<PluginContext, 'events' | 'logger'>, service: AccountsServiceImpl, session: LedgerSession,
+  change: Pick<AccountsChange, 'chart' | 'transactions' | 'categories'> & Partial<Pick<AccountsChange, 'reconciliations'>>
+) {
+  try {
+    if (change.chart) context.events.emit(local(ACCOUNTS_EVENTS.chart), await chartOrNull(service, session))
+    if (change.transactions.length > 0) context.events.emit(local(ACCOUNTS_EVENTS.transactions), { accounts: change.transactions })
+    if (change.categories) context.events.emit(local(ACCOUNTS_EVENTS.categories), await unlessClosed(session, () => service.categories.list(), []))
+    for (const accountId of new Set([...(change.reconciliations ?? []), ...change.transactions])) {
+      context.events.emit(local(ACCOUNTS_EVENTS.reconcile), { accountId, state: await reconcileStateOrNull(service, session, accountId) })
+    }
+  } catch (err) {
+    context.logger.error('[accounts] Could not publish a change', err)
+  }
+}
+
+const accountIdOf = (request: { accountId?: unknown } | undefined) => {
+  if (typeof request?.accountId !== 'string' || request.accountId === '') throw new AccountsError('NOT_FOUND', 'That account no longer exists.')
+  return request.accountId
+}
+
+const idsOf = (request: { ids?: unknown } | undefined) => {
+  if (!Array.isArray(request?.ids) || request.ids.some(id => typeof id !== 'string')) throw new AccountsError('INVALID', 'Choose the transactions.', 'ids')
+  return request.ids as string[]
+}
+
+export function registerIpc(
+  context: PluginContext,
+  service: AccountsServiceImpl,
+  session: LedgerSession,
+  selection: SelectionState,
+  register: RegisterState,
+  actions: ReconcileActions
+): Disposable[] {
+  return [
+    context.ipc.register(ACCOUNTS_CHANNELS.chart, () => chartOrNull(service, session)),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.selection, () => selection.get()),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.select, async (msg: IpcMessage<Selection>) => {
+      if (!isSelection(msg.data)) throw new Error('A selection is { kind: "ledger" } or { kind, id }')
+      await selection.set(msg.data)
+    }),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.saveAccount, async (msg: IpcMessage<SaveAccountRequest>) => {
+      const { id, input, expectedRev } = msg.data ?? {} as Partial<SaveAccountRequest>
+      return toAccountsResult(() => {
+        if (input === undefined) throw new AccountsError('INVALID', 'Enter the account’s details.', 'name')
+        if (typeof id !== 'string') return service.createAccount(input)
+        // The whole form: an optional field it leaves out was emptied, so it is cleared
+        const patch: AccountPatch = {
+          ...input,
+          institution: input.institution ?? null, accountNumber: input.accountNumber ?? null,
+          notes: input.notes ?? null, creditLimit: input.creditLimit ?? null,
+          minimumBalance: input.minimumBalance ?? null, showAvailableBalance: input.showAvailableBalance ?? null
+        }
+        return service.updateAccount(id, patch, typeof expectedRev === 'number' ? { expectedRev } : {})
+      })
+    }),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.move, async (msg: IpcMessage<MoveRequest>) => {
+      const { kind, id, to } = msg.data ?? {} as Partial<MoveRequest>
+      return toAccountsResult(async () => {
+        if (typeof id !== 'string' || (to !== null && typeof to !== 'string')) throw new AccountsError('INVALID', 'Choose where to move it.', 'to')
+        if (kind === 'account') return service.moveAccount(id, to)
+        try {
+          return await session.moveSubLedger(id, to)
+        } catch (err) {
+          // The ledger's reasons (a cycle, a name taken) are the user's to see, in the dialog
+          if (isLedgerError(err)) throw new AccountsError(err.code === 'NOT_FOUND' ? 'NOT_FOUND' : 'INVALID', err.message, 'to')
+          throw err
+        }
+      })
+    }),
+
+    // ---- The register
+
+    context.ipc.register(ACCOUNTS_CHANNELS.registerAccount, () => ({ accountId: register.get() ?? null })),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.loadRegister, async (msg: IpcMessage<{ accountId?: string }>): Promise<RegisterSnapshot | null> => {
+      const accountId = msg.data?.accountId
+      if (!session.current || typeof accountId !== 'string') return null
+      return (await service.get(accountId)) ? service.transactions(accountId).register() : null
+    }),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.saveTransaction, async (msg: IpcMessage<SaveTransactionRequest>) => {
+      const request = msg.data
+      return toAccountsResult(async () => {
+        const manager = service.transactions(accountIdOf(request))
+        if (typeof request.draft !== 'object' || request.draft === null) throw new AccountsError('INVALID', 'Enter the transaction.', 'date')
+        if (typeof request.id !== 'string') return manager.create(request.draft)
+        // The whole row: an optional field it leaves out was emptied, so it is cleared
+        const { draft } = request
+        const patch: TransactionPatch = {
+          ...draft,
+          number: draft.number ?? null, payee: draft.payee ?? null, memo: draft.memo ?? null,
+          categoryId: draft.categoryId ?? null, transferAccountId: draft.transferAccountId ?? null
+        }
+        return manager.update(request.id, patch, {
+          ...(typeof request.expectedRev === 'number' && { expectedRev: request.expectedRev }),
+          ...(Array.isArray(request.confirm) && { confirm: request.confirm })
+        })
+      })
+    }),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.deleteTransactions, async (msg: IpcMessage<TransactionsRequest>) =>
+      toAccountsResult(() => service.transactions(accountIdOf(msg.data)).delete(idsOf(msg.data), { confirm: msg.data?.confirm ?? [] }))),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.setStatus, async (msg: IpcMessage<TransactionsRequest>) =>
+      toAccountsResult(() => {
+        const status = msg.data?.status
+        if (!(CLEARING_STATUSES as readonly unknown[]).includes(status)) throw new AccountsError('INVALID', 'Choose a status.', 'status')
+        return service.transactions(accountIdOf(msg.data)).setStatus(idsOf(msg.data), status as ClearingStatus, { confirm: msg.data?.confirm ?? [] })
+      })),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.setVoided, async (msg: IpcMessage<TransactionsRequest>) =>
+      toAccountsResult(() => service.transactions(accountIdOf(msg.data)).setVoided(idsOf(msg.data), msg.data?.voided === true, { confirm: msg.data?.confirm ?? [] }))),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.patchTransaction, async (msg: IpcMessage<PatchTransactionRequest>) =>
+      toAccountsResult(() => {
+        const request = msg.data
+        if (typeof request?.id !== 'string' || typeof request.patch !== 'object' || request.patch === null) {
+          throw new AccountsError('INVALID', 'Choose the transaction and what to change.', 'id')
+        }
+        return service.transactions(accountIdOf(request)).update(request.id, request.patch, {
+          ...(typeof request.expectedRev === 'number' && { expectedRev: request.expectedRev }),
+          ...(Array.isArray(request.confirm) && { confirm: request.confirm })
+        })
+      })),
+
+    // ---- Reconciling
+
+    context.ipc.register(ACCOUNTS_CHANNELS.reconcileActions, async (msg: IpcMessage<{ accountId?: string, scope?: string }>): Promise<ResolvedReconcileAction[]> => {
+      const accountId = msg.data?.accountId
+      const scope = msg.data?.scope === 'transaction' ? 'transaction' : 'account'
+      if (typeof accountId !== 'string') return []
+      const account = await unlessClosed(session, () => service.get(accountId), undefined)
+      return account ? actions.for(account.type, scope) : []
+    }),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.reconcileState, async (msg: IpcMessage<{ accountId?: string }>) => {
+      const accountId = msg.data?.accountId
+      return typeof accountId === 'string' ? reconcileStateOrNull(service, session, accountId) : null
+    }),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.reconcileMark, async (msg: IpcMessage<ReconcileRequest>) =>
+      toAccountsResult(() => service.reconciliation.mark(accountIdOf(msg.data), idsOf(msg.data), msg.data?.marked !== false))),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.reconcileFinish, async (msg: IpcMessage<ReconcileRequest>) =>
+      toAccountsResult(() => service.reconciliation.finish(accountIdOf(msg.data), { confirm: Array.isArray(msg.data?.confirm) ? msg.data.confirm : [] }))),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.reconcilePause, async (msg: IpcMessage<ReconcileRequest>) =>
+      toAccountsResult(() => service.reconciliation.pause(accountIdOf(msg.data)))),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.reconcileCancel, async (msg: IpcMessage<ReconcileRequest>) =>
+      toAccountsResult(() => service.reconciliation.cancel(accountIdOf(msg.data)))),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.searchPayees, async (msg: IpcMessage<{ prefix?: string }>) =>
+      session.current ? service.payees.search(typeof msg.data?.prefix === 'string' ? msg.data.prefix : '') : []),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.categories, async (): Promise<Category[]> =>
+      unlessClosed(session, () => service.categories.list(), [])),
+
+    context.ipc.register(ACCOUNTS_CHANNELS.createCategory, async (msg: IpcMessage<{ path?: string, kind?: Category['kind'] }>) =>
+      toAccountsResult(() => service.categories.create(String(msg.data?.path ?? ''), msg.data?.kind as Category['kind'])))
+  ]
+}
diff --git a/plugins/accounts/src/privileged/reconcileActions.ts b/plugins/accounts/src/privileged/reconcileActions.ts
new file mode 100644
index 0000000..cc60f7a
--- /dev/null
+++ b/plugins/accounts/src/privileged/reconcileActions.ts
@@ -0,0 +1,60 @@
+// The `accounts.reconcile.actions` extension point: reconciliation options other plugins add to the register (its
+// Reconcile menu, and a row's menu). Contributions are plain data; each names a command, which does the work.
+import type { CommandRegistry, ExtensionRegistry, Logger } from '@tessera/types'
+import {
+  ACCOUNT_TYPES, RECONCILE_ACTIONS_POINT,
+  type AccountType, type ReconcileActionContribution, type ResolvedReconcileAction
+} from '@tessera/accounts-api'
+
+function problemWith(raw: unknown, contributor: string): string | undefined {
+  if (typeof raw !== 'object' || raw === null) return `A reconcile action from "${contributor}" is not an object`
+  const a = raw as Record<string, unknown>
+  const text = (v: unknown) => typeof v === 'string' && v.trim() !== ''
+  if (!text(a.id) || !(a.id as string).startsWith(`${contributor}.`)) return `A reconcile action from "${contributor}" needs an id starting with "${contributor}."`
+  if (!text(a.label)) return `Reconcile action "${a.id}" needs a label`
+  if (a.scope !== 'account' && a.scope !== 'transaction') return `Reconcile action "${a.id}" needs a scope of "account" or "transaction"`
+  if (!text(a.command)) return `Reconcile action "${a.id}" needs a command`
+  if (a.accountTypes !== undefined && (!Array.isArray(a.accountTypes) || a.accountTypes.some(t => !(ACCOUNT_TYPES as readonly unknown[]).includes(t)))) {
+    return `Reconcile action "${a.id}" names an unknown account type`
+  }
+  if (a.order !== undefined && (typeof a.order !== 'number' || !Number.isFinite(a.order))) return `Reconcile action "${a.id}" has an invalid order`
+  if (a.icon !== undefined && !text(a.icon)) return `Reconcile action "${a.id}" has an invalid icon`
+}
+
+export class ReconcileActions {
+  private readonly warned = new Set<string>()
+
+  constructor(
+    private readonly extensions: Pick<ExtensionRegistry, 'getContributions'>,
+    private readonly commands: Pick<CommandRegistry, 'isEnabled' | 'has'>,
+    private readonly log: Pick<Logger, 'warn'>
+  ) {}
+
+  /** Valid contributions, by order then as contributed. Invalid ones are skipped with one warning each. */
+  all(): ReconcileActionContribution[] {
+    const valid: { action: ReconcileActionContribution, seq: number }[] = []
+    const seen = new Set<string>()
+    this.extensions.getContributions(RECONCILE_ACTIONS_POINT).forEach(({ contributor, impl }, seq) => {
+      const problem = problemWith(impl, contributor) ?? (seen.has((impl as { id: string }).id) ? `Duplicate reconcile action "${(impl as { id: string }).id}" ignored` : undefined)
+      if (problem) {
+        if (!this.warned.has(problem)) { this.warned.add(problem); this.log.warn(`[accounts] ${problem}`) }
+        return
+      }
+      const action = impl as ReconcileActionContribution
+      seen.add(action.id)
+      valid.push({ action, seq })
+    })
+    return valid.sort((a, b) => (a.action.order ?? 0) - (b.action.order ?? 0) || a.seq - b.seq).map(v => v.action)
+  }
+
+  /** The actions for an account of this type, in this scope, each enabled exactly when its command is. */
+  for(type: AccountType, scope: 'account' | 'transaction'): ResolvedReconcileAction[] {
+    return this.all()
+      .filter(action => action.scope === scope && (action.accountTypes === undefined || action.accountTypes.includes(type)))
+      .map(({ id, label, scope, command, icon, description }) => ({
+        id, label, scope, command, enabled: this.commands.has(command) && this.commands.isEnabled(command),
+        ...(icon !== undefined && { icon }),
+        ...(description !== undefined && { description })
+      }))
+  }
+}
diff --git a/plugins/accounts/src/privileged/reconcileCore.ts b/plugins/accounts/src/privileged/reconcileCore.ts
