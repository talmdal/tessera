@@ -0,0 +1,49 @@
+// The recent-ledgers list and the last ledger, kept in application state (tier 1), never in a ledger.
+import type { AppState } from '@tessera/types'
+import type { RecentLedger } from '@tessera/ledger-api'
+
+export const RECENT_KEY = 'ledger.recent'
+export const LAST_KEY = 'ledger.last'
+export const RECENT_LIMIT = 10
+
+/** Paths compare as the platform does: Windows and macOS file systems are usually case-insensitive. */
+const samePath = (a: string, b: string) =>
+  process.platform === 'win32' || process.platform === 'darwin' ? a.toLowerCase() === b.toLowerCase() : a === b
+
+function valid(entry: unknown): entry is RecentLedger {
+  const e = entry as Partial<RecentLedger> | null
+  return typeof e?.path === 'string' && typeof e.name === 'string' && typeof e.openedAt === 'string'
+}
+
+export class RecentLedgers {
+  constructor(private readonly state: AppState, private readonly now: () => Date = () => new Date()) {}
+
+  /** Most recently opened first. Whatever is stored is read defensively: a bad entry is dropped, not an error. */
+  async list(): Promise<RecentLedger[]> {
+    const stored = await this.state.get<unknown>(RECENT_KEY)
+    return Array.isArray(stored) ? stored.filter(valid).map(({ path, name, openedAt }) => ({ path, name, openedAt })) : []
+  }
+
+  async add(path: string, name: string): Promise<void> {
+    const rest = (await this.list()).filter(entry => !samePath(entry.path, path))
+    await this.state.set(RECENT_KEY, [{ path, name, openedAt: this.now().toISOString() }, ...rest].slice(0, RECENT_LIMIT))
+    await this.state.set(LAST_KEY, path)
+  }
+
+  async remove(path: string): Promise<void> {
+    await this.state.set(RECENT_KEY, (await this.list()).filter(entry => !samePath(entry.path, path)))
+    const last = await this.last()
+    if (last !== undefined && samePath(last, path)) await this.forgetLast()
+  }
+
+  /** The ledger to reopen at start-up: the one open when the app last quit. */
+  async last(): Promise<string | undefined> {
+    const last = await this.state.get<unknown>(LAST_KEY)
+    return typeof last === 'string' && last !== '' ? last : undefined
+  }
+
+  /** After an explicit Close Ledger, the next start shows the start view rather than reopening it. */
+  async forgetLast(): Promise<void> {
+    await this.state.set(LAST_KEY, null)
+  }
+}
diff --git a/plugins/ledger/src/privileged/SchemaRegistry.ts b/plugins/ledger/src/privileged/SchemaRegistry.ts
new file mode 100644
index 0000000..9a8a49d
--- /dev/null
+++ b/plugins/ledger/src/privileged/SchemaRegistry.ts
@@ -0,0 +1,81 @@
+// The `ledger.schema` extension point: what each domain plugin stores in a ledger, and how to migrate it.
+import type { CollectionSchema, ExtensionRegistry, Logger, ServiceRegistry } from '@tessera/types'
+import {
+  LEDGER_COLLECTIONS, LEDGER_PLUGIN_ID, LEDGER_SCHEMA_POINT, LedgerError, type Migrator, type SchemaContribution
+} from '@tessera/ledger-api'
+
+/** The ledger's own collections: part of the ledger format, not a contribution. */
+export const LEDGER_OWN_COLLECTIONS: CollectionSchema[] = [
+  {
+    name: LEDGER_COLLECTIONS.subLedgers,
+    indexes: [
+      { name: 'byParent', fields: ['parentId', 'order'] },
+      // Sibling names are unique ignoring case; top-level sub-ledgers store parentId: null, which counts as a value
+      { name: 'uniqueName', fields: ['parentId', 'nameKey'], unique: true }
+    ]
+  }
+]
+
+const SERVICE_ID = /^[A-Za-z][\w-]*(\.[\w-]+)+$/
+
+/** Why a contribution is invalid, or undefined. */
+function problemWith(raw: unknown, contributor: string): string | undefined {
+  if (typeof raw !== 'object' || raw === null) return `A ledger.schema contribution from "${contributor}" is not an object`
+  const c = raw as Record<string, unknown>
+  if (c.id !== contributor) return `A ledger.schema contribution from "${contributor}" must have id "${contributor}", not "${String(c.id)}"`
+  if (contributor === LEDGER_PLUGIN_ID) return `"${LEDGER_PLUGIN_ID}" is reserved for the ledger's own collections`
+  if (typeof c.version !== 'number' || !Number.isInteger(c.version) || c.version < 1) return `The ledger.schema of "${contributor}" needs a version that is a whole number of at least 1`
+  if (typeof c.migrator !== 'string' || !SERVICE_ID.test(c.migrator)) return `The ledger.schema of "${contributor}" must name its migrator service, like "${contributor}.migrator"`
+  if (!Array.isArray(c.collections)) return `The ledger.schema of "${contributor}" needs a list of collections`
+  for (const collection of c.collections as unknown[]) {
+    const name = (collection as { name?: unknown } | null)?.name
+    if (typeof name !== 'string' || !name.startsWith(`${contributor}.`) || name.length === contributor.length + 1) {
+      return `The ledger.schema of "${contributor}" declares collection "${String(name)}"; its collections must be named "${contributor}.<name>"`
+    }
+    const indexes = (collection as { indexes?: unknown }).indexes
+    if (indexes !== undefined && !Array.isArray(indexes)) return `Collection "${name}" of "${contributor}" has invalid indexes`
+  }
+}
+
+/**
+ * Reads `ledger.schema` contributions each time it is asked, so plugins that activate later are included. Invalid
+ * contributions are skipped, with one warning each.
+ */
+export class SchemaRegistry {
+  private readonly warned = new Set<string>()
+
+  constructor(
+    private readonly extensions: Pick<ExtensionRegistry, 'getContributions'>,
+    private readonly services: Pick<ServiceRegistry, 'has' | 'get'>,
+    private readonly log: Pick<Logger, 'warn'>
+  ) {}
+
+  /** Valid contributions, ordered by contributor id so migrations run in the same order every time. */
+  contributions(): SchemaContribution[] {
+    const valid = new Map<string, SchemaContribution>()
+    for (const { contributor, impl } of this.extensions.getContributions(LEDGER_SCHEMA_POINT)) {
+      const problem = problemWith(impl, contributor) ?? (valid.has(contributor) ? `"${contributor}" contributed to ledger.schema twice; the first is used` : undefined)
+      if (problem) {
+        if (!this.warned.has(problem)) { this.warned.add(problem); this.log.warn(`[ledger] ${problem}`) }
+        continue
+      }
+      valid.set(contributor, impl as SchemaContribution)
+    }
+    return [...valid.values()].sort((a, b) => a.id.localeCompare(b.id))
+  }
+
+  /** Every collection a ledger is opened with: the ledger's own, then each contributor's. */
+  collections(): CollectionSchema[] {
+    return [...LEDGER_OWN_COLLECTIONS, ...this.contributions().flatMap(c => c.collections)]
+  }
+
+  /** The contributor's migrator. Looked up when a ledger opens, after every plugin has activated. */
+  migrator(contribution: SchemaContribution): Migrator {
+    const migrator = this.services.has(contribution.migrator) ? this.services.get<Migrator>(contribution.migrator) : undefined
+    if (typeof migrator?.migrate !== 'function') {
+      throw new LedgerError('MIGRATION_FAILED',
+        `The data of "${contribution.id}" can’t be prepared: its migrator service "${contribution.migrator}" isn’t available.`)
+    }
+    return migrator
+  }
+}
diff --git a/plugins/ledger/src/privileged/SubLedgers.ts b/plugins/ledger/src/privileged/SubLedgers.ts
new file mode 100644
index 0000000..3f6c984
--- /dev/null
+++ b/plugins/ledger/src/privileged/SubLedgers.ts
@@ -0,0 +1,181 @@
+// The sub-ledger tree, stored in the ledger's own `ledger.subledgers` collection.
+import type { Collection, Database, Doc, Transaction } from '@tessera/types'
+import {
+  LEDGER_COLLECTIONS, LedgerError, descendantIds, isLedgerError, nameKey, uniqueName, validateLedgerName,
+  type SubLedger, type SubLedgerParticipant
+} from '@tessera/ledger-api'
+import { scopedTransaction } from './scopedDatabase'
+
+/** A stored sub-ledger: the public shape plus the key its name is compared by. */
+interface Stored {
+  parentId: string | null
+  name: string
+  nameKey: string
+  order: number
+  notes?: string
+}
+
+const toSubLedger = ({ id, parentId, name, order, notes, rev }: Doc<Stored>): SubLedger =>
+  ({ id, parentId, name, order, rev, ...(notes !== undefined && { notes }) })
+
+/** Storage errors that mean something to the user, as ledger errors; anything else as it was. */
+export function translate(err: unknown): unknown {
+  if (isLedgerError(err)) return err
+  const code = (err as { code?: unknown } | null)?.code
+  if (code === 'UNIQUE_VIOLATION') return new LedgerError('DUPLICATE_NAME', 'A sub-ledger with this name is already there.', 'name')
+  if (code === 'CONFLICT') return new LedgerError('CONFLICT', 'This sub-ledger was changed elsewhere. Try again.')
+  if (code === 'READ_ONLY') return new LedgerError('READ_ONLY', 'This ledger is open read-only.')
+  if (code === 'NOT_OPEN') return new LedgerError('NO_LEDGER', 'No ledger is open.')
+  return err
+}
+
+function checkedName(name: unknown): string {
+  if (typeof name !== 'string') throw new LedgerError('INVALID', 'Enter a name.', 'name')
+  const problem = validateLedgerName(name)
+  if (problem) throw new LedgerError('INVALID', problem, 'name')
+  return name.trim()
+}
+
+/**
+ * Creates, renames, moves and deletes sub-ledgers. Every change is one storage transaction, so sibling order and
+ * the participants' items never end up half-moved. `db` throws NO_LEDGER while no ledger is open.
+ */
+export class SubLedgers {
+  constructor(
+    private readonly db: () => Database,
+    private readonly participants: () => [string, SubLedgerParticipant][]
+  ) {}
+
+  private collection(tx?: Transaction): Collection<Stored> {
+    return (tx ?? this.db()).collection<Stored>(LEDGER_COLLECTIONS.subLedgers)
+  }
+
+  async list(): Promise<SubLedger[]> {
+    try {
+      return (await this.collection().find()).map(toSubLedger)
+    } catch (err) { throw translate(err) }
+  }
+
+  private async write<T>(work: (tx: Transaction) => Promise<T>): Promise<T> {
+    try {
+      return await this.db().transaction(work)
+    } catch (err) { throw translate(err) }
+  }
+
+  private async existing(collection: Collection<Stored>, id: string): Promise<Doc<Stored>> {
+    const found = typeof id === 'string' ? await collection.get(id) : undefined
+    if (!found) throw new LedgerError('NOT_FOUND', 'That sub-ledger no longer exists.')
+    return found
+  }
+
+  private async parent(collection: Collection<Stored>, parentId: string | null): Promise<void> {
+    if (parentId === null) return
+    if (!(await collection.get(parentId))) throw new LedgerError('NOT_FOUND', 'The parent ledger no longer exists.', 'parentId')
+  }
+
+  private async siblings(collection: Collection<Stored>, parentId: string | null) {
+    return collection.find({ parentId }, { sort: { order: 1 } })
+  }
+
+  async create(input: { name: string, parentId: string | null, notes?: string }): Promise<SubLedger> {
+    const name = checkedName(input?.name)
+    const parentId = input.parentId ?? null
+    return this.write(async tx => {
+      const collection = this.collection(tx)
+      await this.parent(collection, parentId)
+      const siblings = await this.siblings(collection, parentId)
+      if (siblings.some(s => s.nameKey === nameKey(name))) {
+        throw new LedgerError('DUPLICATE_NAME', `There is already a “${name}” there.`, 'name')
+      }
+      const order = siblings.reduce((max, s) => Math.max(max, s.order), -1) + 1
+      const created = await collection.insert({
+        parentId, name, nameKey: nameKey(name), order,
+        ...(input.notes !== undefined && { notes: input.notes })
+      })
+      return toSubLedger(created)
+    })
+  }
+
+  async rename(id: string, newName: string, options: { expectedRev?: number } = {}): Promise<SubLedger> {
+    const name = checkedName(newName)
+    return this.write(async tx => {
+      const collection = this.collection(tx)
+      const current = await this.existing(collection, id)
+      const siblings = await this.siblings(collection, current.parentId)
+      if (siblings.some(s => s.id !== id && s.nameKey === nameKey(name))) {
+        throw new LedgerError('DUPLICATE_NAME', `There is already a “${name}” there.`, 'name')
+      }
+      const { rev, ...rest } = current
+      const renamed = await collection.replace({ ...rest, name, nameKey: nameKey(name) },
+        options.expectedRev === undefined ? {} : { expectedRev: options.expectedRev })
+      return toSubLedger(renamed)
+    })
+  }
+
+  /** Moves a sub-ledger under `to` (null: the ledger itself), at `index` among its new siblings (default: last). */
+  async move(id: string, to: string | null, index?: number): Promise<void> {
+    const target = to ?? null
+    await this.write(async tx => {
+      const collection = this.collection(tx)
+      const moving = await this.existing(collection, id)
+      await this.parent(collection, target)
+      if (target !== null) {
+        const all = (await collection.find()).map(toSubLedger)
+        if (target === id || descendantIds(all, id).has(target)) {
+          throw new LedgerError('CYCLE', `“${moving.name}” can’t be moved into itself or one of its own sub-ledgers.`)
+        }
+      }
+
+      const siblings = (await this.siblings(collection, target)).filter(s => s.id !== id)
+      if (target !== moving.parentId && siblings.some(s => s.nameKey === moving.nameKey)) {
+        throw new LedgerError('DUPLICATE_NAME', `There is already a “${moving.name}” there.`)
+      }
+      const at = index === undefined ? siblings.length : Math.max(0, Math.min(Math.trunc(index), siblings.length))
+      const ordered = [...siblings.slice(0, at), moving, ...siblings.slice(at)]
+
+      // Renumber densely; write only what changed
+      for (const [order, doc] of ordered.entries()) {
+        const parentId = doc.id === id ? target : doc.parentId
+        if (doc.order === order && doc.parentId === parentId) continue
+        await collection.updateOne({ id: doc.id }, { $set: { order, parentId } })
+      }
+      // …and close the gap it left behind
+      if (moving.parentId !== target) {
+        for (const [order, doc] of (await this.siblings(collection, moving.parentId)).entries()) {
+          if (doc.order !== order) await collection.updateOne({ id: doc.id }, { $set: { order } })
+        }
+      }
+    })
+  }
+
+  /**
+   * Deletes a sub-ledger after moving everything in it to its parent: each participant's items, then its own
+   * sub-ledgers (after the parent's existing ones, renamed " (2)"… where a name is taken). One transaction: if a
+   * participant throws, nothing changes.
+   */
+  async delete(id: string): Promise<{ movedTo: string | null }> {
+    return this.write(async tx => {
+      const collection = this.collection(tx)
+      const doomed = await this.existing(collection, id)
+      const parentId = doomed.parentId
+
+      for (const [contributor, participant] of this.participants()) {
+        await participant.reparent(scopedTransaction(tx, contributor), id, parentId)
+      }
+
+      // Deleted before its children move up, so a child named like it ("Business" in "Business") can take its place
+      const children = await this.siblings(collection, id)
+      await collection.deleteOne({ id })
+
+      const staying = await this.siblings(collection, parentId)
+      const taken = new Set(staying.map(s => s.nameKey))
+      let order = staying.reduce((max, s) => Math.max(max, s.order), -1)
+      for (const child of children) {
+        const name = uniqueName(child.name, taken)
+        taken.add(nameKey(name))
+        await collection.updateOne({ id: child.id }, { $set: { parentId, order: ++order, name, nameKey: nameKey(name) } })
+      }
+      return { movedTo: parentId }
+    })
+  }
+}
