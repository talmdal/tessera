index 0000000..e197a8a
--- /dev/null
+++ b/plugins/ledger/src/privileged/index.ts
@@ -0,0 +1,93 @@
+// The ledger plugin: the file that holds a user's finances and its sub-ledgers. Domain-free: it never mentions
+// accounts; domain plugins declare their collections through `ledger.schema` and use `ledger.session`.
+// See docs/account-manager-design.md, "The ledger".
+import type { AppState, PluginContext, ShellFiles, ShellPrompts, StorageEngine } from '@tessera/types'
+import { SHELL_FILES_SERVICE, SHELL_PROMPTS_SERVICE } from '@tessera/types'
+import { LEDGER_PLUGIN_ID, LEDGER_SESSION_SERVICE, LEDGER_VIEWS, type LedgerSession } from '@tessera/ledger-api'
+import { registerCommands, revealer } from './commands'
+import { contributions } from './contributions'
+import { nodeDisk, type LedgerDisk } from './disk'
+import { LedgerPublisher, registerIpc } from './ipc'
+import { LedgerSessionImpl, describeError, ledgerName } from './LedgerSessionImpl'
+import { RecentLedgers } from './RecentLedgers'
+import { SchemaRegistry } from './SchemaRegistry'
+
+let active: LedgerSessionImpl | undefined
+
+/** Exactly the `LedgerSession` contract, so other plugins can't reach the implementation's internals. */
+export function publicSession(session: LedgerSessionImpl): LedgerSession {
+  return {
+    get current() { return session.current },
+    database: contributor => session.database(contributor),
+    create: (file, options) => session.create(file, options),
+    open: file => session.open(file),
+    close: () => session.close(),
+    delete: file => session.delete(file),
+    tree: () => session.tree(),
+    createSubLedger: input => session.createSubLedger(input),
+    renameSubLedger: (id, name, options) => session.renameSubLedger(id, name, options),
+    moveSubLedger: (id, to, index) => session.moveSubLedger(id, to, index),
+    deleteSubLedger: id => session.deleteSubLedger(id),
+    participate: (contributor, participant) => session.participate(contributor, participant),
+    registerNavigator: contributor => session.registerNavigator(contributor),
+    onWillClose: listener => session.onWillClose(listener),
+    onDidChange: session.onDidChange,
+    onDidChangeTree: session.onDidChangeTree
+  }
+}
+
+export async function activate(context: PluginContext, options: { disk?: LedgerDisk } = {}) {
+  const engine = context.services.get<StorageEngine>('storage.engine')
+  const appState = context.services.get<AppState>('app.state')
+  const files = context.services.get<ShellFiles>(SHELL_FILES_SERVICE)
+  const prompts = context.services.get<ShellPrompts>(SHELL_PROMPTS_SERVICE)
+  const disk = options.disk ?? nodeDisk()
+
+  const recent = new RecentLedgers(appState)
+  const schema = new SchemaRegistry(context.extensions, context.services, context.logger)
+  const session = new LedgerSessionImpl({ engine, files, prompts, recent, schema, disk, log: context.logger })
+  const publisher = new LedgerPublisher(context, session, recent, disk)
+  active = session
+
+  context.subscriptions.push(
+    session.onDidChange(change => {
+      if (change.type === 'opened') publisher.setError(undefined)
+      else {
+        publisher.publishState()
+        publisher.publishTree(null)
+      }
+      void publisher.publishRecent()
+    }),
+    session.onDidChangeTree(tree => publisher.publishTree(tree)),
+    session.onDidChangeNavigator(() => publisher.publishState()),
+    ...contributions().map(([point, id, impl]) => context.extensions.contribute(LEDGER_PLUGIN_ID, point, id, impl)),
+    ...registerCommands(context, session, prompts),
+    ...registerIpc(context, session, publisher, recent),
+    context.services.provide(LEDGER_PLUGIN_ID, LEDGER_SESSION_SERVICE, publicSession(session)),
+    // On quit the ledger closes but is remembered, so it reopens at the next start
+    context.lifecycle.onShuttingDown(() => session.shutdown())
+  )
+
+  // Reopen the last ledger once every plugin has activated: the schema contributors and their migrators are there
+  context.lifecycle.onStarted(async () => {
+    const last = await recent.last().catch(() => undefined)
+    if (last !== undefined) {
+      try {
+        await session.open(last)
+      } catch (err) {
+        context.logger.warn(`[ledger] Could not reopen ${last}: ${describeError(err)}`)
+        publisher.setError(`“${ledgerName(last)}” could not be reopened. ${describeError(err)}`)
+      }
+    }
+    if (!session.current) await revealer(context)(LEDGER_VIEWS.start)
+  })
+
+  publisher.publishState()
+}
+
+/** Runs after every plugin that requires `ledger.session` has deactivated. */
+export async function deactivate() {
+  const session = active
+  active = undefined
+  await session?.shutdown()
+}
diff --git a/plugins/ledger/src/privileged/ipc.ts b/plugins/ledger/src/privileged/ipc.ts
new file mode 100644
index 0000000..0d8acf2
--- /dev/null
+++ b/plugins/ledger/src/privileged/ipc.ts
@@ -0,0 +1,109 @@
+// The ledger's views talk to it here: requests, and the state they follow through push events.
+import type { Disposable, IpcMessage, PluginContext } from '@tessera/types'
+import {
+  LEDGER_CHANNELS, LEDGER_CONTEXT_KEYS, LEDGER_EVENTS, LEDGER_PLUGIN_ID, toResult,
+  type LedgerState, type LedgerTree, type RecentLedger
+} from '@tessera/ledger-api'
+import type { LedgerDisk } from './disk'
+import type { LedgerSessionImpl } from './LedgerSessionImpl'
+import type { RecentLedgers } from './RecentLedgers'
+
+/** `events.emit` adds the plugin's prefix itself: 'ledger:state.changed' is emitted as 'state.changed'. */
+const local = (event: string) => event.slice(`${LEDGER_PLUGIN_ID}:`.length)
+
+const text = (value: unknown, what: string) => {
+  if (typeof value !== 'string' || value === '') throw new Error(`${what} is required`)
+  return value
+}
+
+/**
+ * Mirrors the session into context keys (for menus and `when`) and push events (for views). Events carry the
+ * whole new value, so a view that applies one twice is still right.
+ */
+export class LedgerPublisher {
+  private error: string | undefined
+
+  constructor(
+    private readonly context: Pick<PluginContext, 'contextKeys' | 'events' | 'logger'>,
+    private readonly session: LedgerSessionImpl,
+    private readonly recent: RecentLedgers,
+    private readonly disk: LedgerDisk
+  ) {}
+
+  state(): LedgerState {
+    const ledger = this.session.current
+    return { isOpen: ledger !== undefined, ...(ledger && { ledger }), ...(this.error !== undefined && { error: this.error }) }
+  }
+
+  /** A failure to show on the start view (reopening at start-up), or undefined to clear it. */
+  setError(error: string | undefined) {
+    this.error = error
+    this.publishState()
+  }
+
+  publishState() {
+    const { ledger } = this.state()
+    const keys = this.context.contextKeys
+    keys.set(LEDGER_CONTEXT_KEYS.isOpen, ledger !== undefined)
+    keys.set(LEDGER_CONTEXT_KEYS.isReadOnly, ledger?.readOnly ?? false)
+    keys.set(LEDGER_CONTEXT_KEYS.name, ledger?.name)
+    keys.set(LEDGER_CONTEXT_KEYS.hasNavigator, this.session.hasNavigator)
+    this.context.events.emit(local(LEDGER_EVENTS.state), this.state())
+  }
+
+  publishTree(tree: LedgerTree | null) {
+    this.context.events.emit(local(LEDGER_EVENTS.tree), tree)
+  }
+
+  async recentLedgers(): Promise<RecentLedger[]> {
+    return Promise.all((await this.recent.list()).map(async entry => ({ ...entry, exists: await this.disk.exists(entry.path) })))
+  }
+
+  async publishRecent() {
+    try {
+      this.context.events.emit(local(LEDGER_EVENTS.recent), await this.recentLedgers())
+    } catch (err) {
+      this.context.logger.warn(`[ledger] Could not read the recent ledgers: ${err instanceof Error ? err.message : String(err)}`)
+    }
+  }
+}
+
+export function registerIpc(context: PluginContext, session: LedgerSessionImpl, publisher: LedgerPublisher, recent: RecentLedgers): Disposable[] {
+  return [
+    context.ipc.register(LEDGER_CHANNELS.state, () => publisher.state()),
+
+    context.ipc.register(LEDGER_CHANNELS.recent, () => publisher.recentLedgers()),
+
+    context.ipc.register(LEDGER_CHANNELS.recentRemove, async (msg: IpcMessage<{ path?: unknown }>) => {
+      await recent.remove(text(msg.data?.path, 'A path'))
+      await publisher.publishRecent()
+    }),
+
+    context.ipc.register(LEDGER_CHANNELS.open, async (msg: IpcMessage<{ path?: unknown }>) => {
+      const file = text(msg.data?.path, 'A path')
+      return toResult(() => session.open(file))
+    }),
+
+    context.ipc.register(LEDGER_CHANNELS.delete, async (msg: IpcMessage<{ path?: unknown }>) => {
+      const deleted = await session.delete(text(msg.data?.path, 'A path'))
+      await publisher.publishRecent()
+      return deleted
+    }),
+
+    context.ipc.register(LEDGER_CHANNELS.tree, async () => session.current ? session.tree() : null),
+
+    context.ipc.register(LEDGER_CHANNELS.createSubLedger, async (msg: IpcMessage<{ name?: unknown, parentId?: unknown }>) => {
+      const { name, parentId } = msg.data ?? {}
+      return toResult(() => session.createSubLedger({
+        name: typeof name === 'string' ? name : '',
+        parentId: typeof parentId === 'string' ? parentId : null
+      }))
+    }),
+
+    context.ipc.register(LEDGER_CHANNELS.renameSubLedger, async (msg: IpcMessage<{ id?: unknown, name?: unknown, expectedRev?: unknown }>) => {
+      const { id, name, expectedRev } = msg.data ?? {}
+      return toResult(() => session.renameSubLedger(text(id, 'An id'), typeof name === 'string' ? name : '',
+        typeof expectedRev === 'number' ? { expectedRev } : {}))
+    })
+  ]
+}
