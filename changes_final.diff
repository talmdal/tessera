+    await userEvent.click(item('Personal'))
+    await userEvent.click(screen.getByRole('button', { name: 'New sub-ledger' }))
+    expect(b.executed().at(-1)).toEqual({ id: LEDGER_COMMANDS.new, args: [{ parentId: 'p' }] })
