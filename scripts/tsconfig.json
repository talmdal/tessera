{
  "compilerOptions": {
    // Type-checking only: the scripts run through ts-node and esbuild, never from an emitted copy
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@tessera/types": [
        "../tessera-types/index.ts"
      ],
      "@tessera/storage-kit": [
        "../packages/storage-kit/index.ts"
      ],
      "@tessera/book-api": [
        "../packages/book-api/index.ts"
      ],
      "@tessera/accounts-api": [
        "../packages/accounts-api/index.ts"
      ],
      "@tessera/exchange-api": [
        "../packages/exchange-api/index.ts"
      ]
    },
    "baseUrl": ".",
    "strict": true,
    "target": "ESNext",
    "lib": [
      "ESNext"
    ]
  },
  "include": [
    "dev.mts",
    "build-plugins.mts",
    "seed-book.mts",
    "bench-backup.mts",
    "anonymize-statement.mts",
    "seed/**/*.ts",
    "bench/**/*.ts",
    "anonymize/**/*.ts",
    "../plugins/storage.loki/src/lokijs.d.ts"
  ]
}
